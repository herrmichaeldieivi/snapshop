NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=
SENTRY_DSN=
RATE_LIMIT_STORE=

# --- Instagram & Facebook sync -------------------------------------------------
# Without META_APP_ID/META_APP_SECRET the Sync panel runs in preview mode (sample posts, nothing is ever posted)
# in demo mode, and refuses to fake it when a real Supabase backend is configured. META_MOCK=1 forces preview mode.
META_APP_ID=
META_APP_SECRET=
# Optional: Graph API version (default v26.0), "Facebook Login for Business" configuration id, or a custom scope list.
META_GRAPH_VERSION=
META_LOGIN_CONFIG_ID=
META_SCOPES=
META_MOCK=
# Required in production: encrypts stored Meta tokens and signs the OAuth state. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Must be your public https:// URL for posting to work: Meta fetches product photos from it.
NEXT_PUBLIC_SITE_URL=
